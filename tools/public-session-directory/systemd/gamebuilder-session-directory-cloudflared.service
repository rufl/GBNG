[Unit]
Description=Temporary public Quick Tunnel for Game Builder session directory
After=gamebuilder-session-directory-caddy.service
Requires=gamebuilder-session-directory-caddy.service

[Service]
Type=simple
ExecStart=%h/.local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:47802
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
